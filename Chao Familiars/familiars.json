{
  "Changes": [

    // Load assets
    {
      "Action": "Load",
      "Target": "Mods/{{ModId}}/sprites/baseChao",
      "FromFile": "sprites/{{TargetWithoutPath}}.png",
    },
    {
      "Action": "Load",
      "Target": "Mods/{{ModId}}/icons/chaoIcon",
      "FromFile": "icons/{{TargetWithoutPath}}.png",
    },
    {
      "Action": "Load",
      "Target": "Mods/{{ModId}}/maps/baseChaoDen",
      "FromFile": "maps/{{TargetWithoutPath}}.tmx",
    },

    // Load familiars

    {
      "Action": "Include",
      "FromFile": "familiars/baseChao.json",
    },
    
  ]
}